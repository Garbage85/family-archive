[Unit]
Description=Family Tree PocketBase
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=familytree
Group=familytree
WorkingDirectory=/opt/family-tree
ExecStart=/opt/family-tree/pocketbase serve --http=0.0.0.0:8090
Restart=on-failure
RestartSec=5
LimitNOFILE=4096
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/family-tree/pb_data /opt/family-tree/pb_migrations

[Install]
WantedBy=multi-user.target
